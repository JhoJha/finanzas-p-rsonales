# Solo variables de servidor: nunca antepongas VITE_ a secretos.
# Déjalas sin valor para ejecutar la aplicación local-first sin servicios remotos.

# Supabase: identidad, sesión, perfil y consumo. La clave publicable puede viajar
# al navegador cuando se implemente el cliente de auth; esta API la usa solo aquí.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# DeepSeek: se usa únicamente desde src/lib/server/. Nunca se expone al cliente.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# La cuota se habilitará con un adaptador persistente de Supabase en la Fase 7.
MONTHLY_AI_LIMIT=0
